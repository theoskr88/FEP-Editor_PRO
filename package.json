{
  "name": "fep-editor-pro",
  "version": "0.9.7",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "serve": "python3 -m http.server 8790 --bind 127.0.0.1",
    "test:regressions": "node tests/regressions.mjs",
    "test:reliability": "node tests/reliability-browser.mjs",
    "package": "python3 scripts/package.py",
    "test:package": "node tests/package-browser.mjs",
    "test:glitter": "node tests/glitter-browser.mjs && node tests/print-files.mjs",
    "test:interface": "node tests/interface-browser.mjs",
    "test:boot": "node tests/boot.mjs",
    "test:stickers": "node tests/stickers-browser.mjs",
    "test:consolidation": "node tests/consolidation-browser.mjs",
    "test:free": "node tests/free-browser.mjs",
    "test:free:recovery": "node tests/free-recovery-browser.mjs",
    "test:free:limits": "node tests/free-limits-browser.mjs",
    "test:vector": "node tests/vector-browser.mjs",
    "test:acceptance": "node tests/acceptance-browser.mjs",
    "test:profiles": "node tests/profiles-browser.mjs",
    "test:creative": "node tests/creative-browser.mjs",
    "test:mockup": "node tests/mockup-browser.mjs",
    "test:print": "node tests/print-browser.mjs",
    "test:zones": "node tests/zones-browser.mjs",
    "test:accessories": "node tests/accessories-browser.mjs",
    "test:scenes": "node tests/scenes-browser.mjs"
  },
  "dependencies": {
    "clipper-lib": "6.4.2",
    "three": "0.170.0",
    "webm-muxer": "5.1.4"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "playwright-core": "1.58.2"
  }
}
